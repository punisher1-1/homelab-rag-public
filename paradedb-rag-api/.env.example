# ⚠️ NEVER put an inline comment on a line whose value is EMPTY.
#    `GEN_MODEL=        # blank = auto-detect`  →  the VALUE becomes "# blank = auto-detect".
#    The dotenv parser strips a trailing " # comment" only when a real value precedes it,
#    so `TOP_K=6  # chunks` is fine and blank-by-design vars are the booby trap.
#    Cost us a broken cutover on 2026-07-28. Verify with:
#      docker exec paradedb-rag-api printenv | grep -E '^(GEN_|RERANK_)'
#
# Copy to ".env" and fill in DB_PASSWORD. Never commit .env.

# --- ParadeDB ---
DB_HOST=paradedb-host
DB_PORT=5432
DB_NAME=myragdatabase
DB_USER=myuser
DB_PASSWORD=change_me

# --- Embeddings (Ollama bge-m3 on the Z2 Mini) ---
OLLAMA_URL=http://embed-host:11434
EMBED_MODEL=bge-m3:latest

# --- Generation backend (any OpenAI-compatible server) ---
# Pick ONE. Both live on the gpu-node and share the same 16 GB card, so only one
# can hold VRAM at a time — that is by design, not a limitation to work around.
#
#   vLLM           :8000  — fastest steady-state (prefix caching), model fixed at
#                           `docker run` time, no API key as we run it
#   Unsloth Studio :8888  — swap models + context length from the web UI in seconds,
#                           REQUIRES a bearer key
#
GEN_URL=http://gen-host:8888/v1
# Bearer token. Required for Unsloth Studio (sk-unsloth-…); leave BLANK for vLLM.
# Bitwarden: "gpu-node Unsloth API key".
GEN_API_KEY=
# Leave GEN_MODEL blank to auto-detect whatever the backend is serving — with
# Unsloth that means changing the loaded model in the UI takes effect on the next
# message, no restart. Pin it (e.g. ibm-granite/granite-4.1-8b-fp8) only if the
# backend advertises several models and you want a specific one.
GEN_MODEL=
#
# Legacy names VLLM_URL / VLLM_MODEL / VLLM_API_KEY are still read as fallbacks
# if GEN_* are unset, so an old .env keeps working.

# --- Generation parameters — the GATEWAY is the authority (added 2026-08-01) ---
# Clients send their own temperature/max_tokens and silently different client
# defaults already confounded one A/B (0.57 vs 0.2, found 2026-07-28). With
# ALLOW_CLIENT_PARAMS=false (the default) the values HERE win for every client —
# Open WebUI, the web frontend, eval runs — so results are reproducible.
# NOTE: the model's CONTEXT WINDOW is not set here — that is fixed where the
# model is loaded (Unsloth Studio per-model UI / vLLM --max-model-len).
GEN_TEMPERATURE=0.2
GEN_MAX_TOKENS=0             # response cap in tokens; 0 = no cap
ALLOW_CLIENT_PARAMS=false

# --- Retrieval behaviour ---
MODEL_NAME=paradedb-rag      # the name Open WebUI will show
TOP_K=6                      # chunks sent to the model
MIN_SIM=0.0                  # vector-leg cosine floor (0.0 = no floor, your call)
CANDIDATES=20                # pulled from each leg before fusion
SHOW_SOURCES=true            # append a Sources list to answers

# --- Provenance guard (added 2026-08-09) ---
# The Sources list is built from what RETRIEVAL returned, not from what the model
# wrote — so a model that says "this came from my training, not your documents"
# was still getting real, page-accurate citations printed above that sentence.
# NOTE: no inline comment on this line's value in the live .env — see the
# empty-value parsing gotcha in README.md.
#   warn     = keep the list, relabel it "Retrieved (not cited)" + warning banner
#   suppress = drop the list, print one line explaining why
#   off      = pre-2026-08-09 behaviour (always append)
DISCLAIM_GUARD=warn

# Discard "Sources:" lists the MODEL writes for itself — it learned the format from
# SYSTEM_PROMPT and now emits it even for ungrounded answers (2026-08-09: it cited an
# ATF Paperwork Reduction Act notice as the source for PowerPoint length advice).
# The gateway appends the authoritative list; the model's are noise at best.
# Trade-off: true makes streaming LINE-buffered instead of token-buffered.
STRIP_MODEL_SOURCES=true

# --- Abstention floor (added 2026-08-09) ---
# MIN_SIM=0.0 + RRF means retrieval ALWAYS returns a top-k — there is no "nothing
# matched" state, so a question the corpus cannot answer still gets a Sources list.
# These do NOT filter retrieval; MIN_SIM stays 0.0 and the model still sees every
# chunk. They gate the CLAIM OF GROUNDING: below the floor, the Sources block is
# replaced with an honest note and the model is told its passages are weak.
#
# BOTH SHIP OFF. Every turn logs `[floor] top_sim=… top_rerank=…` whether or not a
# floor is set — collect a few days of real queries, compare the numbers on good
# turns vs bad ones, THEN set a threshold. Do not guess these.
ABSTAIN_MIN_SIM=0.0        # 0.0 = off. Cosine floor on the best vector hit.
# ABSTAIN_MIN_RERANK=      # blank = off. Cross-encoder floor; wins when set.

# --- Collection scoping (added 2026-08-01) ---
# Comma-separated drop-zone collections (the dropzone/ subfolder names). Each is
# advertised as a model variant — paradedb-rag-atf, paradedb-rag-nist — so an
# Open WebUI chat can be scoped to ONE corpus by picking the model. A custom
# frontend can instead send "collection" (and optionally "source": vault |
# dropzone) in the request body, which wins over the model suffix.
COLLECTIONS=atf,nist

# --- Reranker (optional cross-encoder precision pass) ---
# Point at the TEI/llama.cpp rerank server on the MSI; blank = off.
RERANK_URL=http://reranker-host:8080
RERANK_BACKEND=tei           # tei | llamacpp
RERANK_CANDIDATES=20         # RRF candidates re-scored; TOP_K survive to the model

# Scope retrieval to one lab/source; blank = all. Lab tags come from ingest (home, or RAG_LAB_FOLDERS).
RAG_LAB=home

# --- Retrieval-only search endpoint (POST /v1/search) ---
# Used by the local model harness (on its own host) as its rag_search tool. OFF while blank.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the same value as HARNESS_RAG_TOKEN in the harness .env.
SEARCH_TOKEN=
SEARCH_TEXT_CHARS=4000       # per-passage cap in search results
