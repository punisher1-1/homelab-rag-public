# Copy this file to ".env" and fill in the password.
# The .env file holds secrets and should NEVER be committed to git.

# --- ParadeDB connection ---
DB_HOST=paradedb-host
DB_PORT=5432
DB_NAME=myragdatabase
DB_USER=myuser
DB_PASSWORD=change_me

# --- Embedding model (Ollama on the Z2 Mini) ---
# bge-m3 outputs 1024-dim vectors, which must match the chunks.embedding column.
OLLAMA_URL=http://embed-host:11434
EMBED_MODEL=bge-m3:latest
EMBED_DIM=1024

# --- Reranker (optional cross-encoder precision pass) ---
# Point at a TEI or llama.cpp rerank server on the MSI; blank = reranking off.
RERANK_URL=http://reranker-host:8080
RERANK_BACKEND=tei          # tei | llamacpp
RERANK_CANDIDATES=20        # how many RRF candidates the reranker re-scores

# --- Eval defaults — KEEP IN SYNC with paradedb-rag-api/.env ---
# eval.py uses these as its --k / --min-sim defaults, so an unflagged eval run
# scores the DEPLOYED gateway config instead of a literal that drifted from it.
TOP_K=6
MIN_SIM=0.0

# --- Content governance ---
# Notes are ingested by DEFAULT. A note is excluded only if its frontmatter
# `status:` contains one of these keywords (speculative/dead). Everything else —
# untagged, "active", "completed", "published", "living", "deployed", ... — is kept.
RAG_EXCLUDE_STATUSES=draft,outline,planning,plan,propos,idea,placeholder,in-progress,wip,retire,deactiv,deprecat,archiv,obsolet,supersed,historical,shelved

# Scope retrieval to one lab/source (provenance filter). Blank = search everything.
# Notes are tagged `home` unless a folder rule below (or frontmatter `lab:`) says otherwise.
RAG_LAB=home
# Folder name=lab tag pairs, comma-separated, e.g. Work Project=work,Network Team=netops
RAG_LAB_FOLDERS=

# --- What to ingest ---
# Point these at the folders you want in your knowledge base.
OBSIDIAN_VAULT=/path/to/your/obsidian-vault

# PDF_DIR: either a local folder, OR reuse the same NAS share Omni ingests from.
# Local (simplest to start):
PDF_DIR=./pdfs

# --- Approved document store ---
# Point this at documents/approved and run `python ingest.py --documents-only`.
# The SUBFOLDER NAME becomes the chunk's `collection` tag, so you can query
# one corpus at a time:  query.py "..." --collection nist
DROP_DIR=/path/to/rag-store/documents/approved
# macOS NAS example:
# DROP_DIR=/Volumes/RAG_Files/rag-store/documents/approved

# Docling code items lose their line breaks; ingest.py reads them back from the
# raw PDF (found by origin.filename, verified by hash). Both default to folders
# next to approved/: documents/raw and documents/reference-fonts.
# RAW_DIR=/Volumes/RAG_Files/rag-store/documents/raw
# CODE_REF_FONT_DIR=/Volumes/RAG_Files/rag-store/documents/reference-fonts
